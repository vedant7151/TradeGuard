{
  "info": {
    "name": "TradeGuard API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order (Collection Runner) to exercise the full trade lifecycle."
  },
  "item": [
    {
      "name": "1. Create portfolio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/portfolios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "portfolios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Portfolio\",\n  \"cashBalance\": 10000\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('portfolioId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create trade (DRAFT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"portfolioId\": \"{{portfolioId}}\",\n  \"ticker\": \"AAPL\",\n  \"tradeType\": \"BUY\",\n  \"quantity\": 10,\n  \"price\": 150.0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 DRAFT', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('DRAFT'); });",
              "pm.collectionVariables.set('tradeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Validate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}",
            "validate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('VALIDATED', () => pm.expect(pm.response.json().status).to.eql('VALIDATED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Match",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}/match",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}",
            "match"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('MATCHED', () => pm.expect(pm.response.json().status).to.eql('MATCHED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Settle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}/settle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}",
            "settle"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('SETTLED', () => pm.expect(pm.response.json().status).to.eql('SETTLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Positions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/portfolios/{{portfolioId}}/positions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "portfolios",
            "{{portfolioId}}",
            "positions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('AAPL x10', () => pm.expect(Number(pm.response.json()[0].quantity)).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Get portfolio (cash 8500)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/portfolios/{{portfolioId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "portfolios",
            "{{portfolioId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cash 8500', () => pm.expect(Number(pm.response.json().cashBalance)).to.eql(8500));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Get trade",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}"
          ]
        }
      }
    },
    {
      "name": "9. List trades by status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades?status=SETTLED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades?status=SETTLED"
          ]
        }
      }
    },
    {
      "name": "10. Settle again -> 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}/settle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}",
            "settle"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Cancel settled -> 409",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/{{tradeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "{{tradeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Unknown trade -> 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trades/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trades",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "portfolioId",
      "value": ""
    },
    {
      "key": "tradeId",
      "value": ""
    }
  ]
}